#!/bin/bash
# how to use: ds9-client <station-number>
# Stations: 1=parrot, 2=parakeet, 3=albatross, 4=peacock, 5=emu, 6=falcon

# set station number
if test $# -ne 1; then
    echo "usage: $0 <station-number 1-6>"
    exit 1
fi

AGENTS=(parrot parakeet albatross peacock emu falcon)
IDX=$(($1 - 1))

if [ $IDX -lt 0 ] || [ $IDX -gt 5 ]; then
    echo "station must be 1-6"
    exit 1
fi

AGENT=${AGENTS[$IDX]}

# turn wifi off
networksetup -setairportpower en0 off
# set dac and volume
# system-sound-to-motu
osascript -e "set Volume 4"

cleanup() {
    echo -e "\nShutting down..."
    networksetup -setairportpower en0 on
    exit 0
}
trap cleanup SIGINT

# run client script
echo "Starting DS9 client: station $1 -> $AGENT"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
pushd "$SCRIPT_DIR/.."
chuck -c6 client.ck:$AGENT
popd

# turn wifi back on
networksetup -setairportpower en0 on
