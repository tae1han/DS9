#!/bin/bash
# how to use: ds9-client <station-number>
# Stations: 1=parrot, 2=parakeet, 3=albatross, 4=peacock, 5=emu, 6=falcon

# set station number
if test $# -ne 1; then
    echo "usage: $0 <station-number 1-6>"
    exit 1
fi

AGENTS=(parrot parakeet albatross peacock emu falcon)
IDX=$(($1 - 1))

if [ $IDX -lt 0 ] || [ $IDX -gt 5 ]; then
    echo "station must be 1-6"
    exit 1
fi

AGENT=${AGENTS[$IDX]}

# Resolve symlinks so this works when invoked via PATH symlink.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# turn wifi off
networksetup -setairportpower en0 off
# set dac and volume
# system-sound-to-motu
osascript -e "set Volume 4"

cleanup() {
    echo -e "\nShutting down..."
    networksetup -setairportpower en0 on
    exit 0
}
trap cleanup SIGINT

# run client script
echo "Starting DS9 client: station $1 -> $AGENT"
if [ ! -f "$PROJECT_DIR/client.ck" ] || [ ! -f "$PROJECT_DIR/agent.ck" ]; then
    echo "Error: expected DS9 v6 files not found in $PROJECT_DIR"
    echo "Make sure this script is inside DS9/v6/scripts (or symlinked to it)."
    exit 1
fi

pushd "$PROJECT_DIR" >/dev/null || exit 1
chuck -c6 client.ck:$AGENT --bufsize:1024
popd

# turn wifi back on
networksetup -setairportpower en0 on
