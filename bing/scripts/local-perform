#!/bin/bash
# One-terminal performance stack: 8 clients + autonomous feeder + GameTrak + server.
#
# Usage (from DS9/v10-dev):
#   ./scripts/local-perform
#   ./scripts/local-perform "USB Midi Cable"
#
# Same as local-run, plus feeder (idle until pedal 1) and GameTrak in background.
# Logs: .local-logs/{client-*,feeder,gametrak}.log
# Stop: Ctrl+C here, or ./scripts/local-stop

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT_DIR/.local-logs"

MIDI_DEV="USB Midi Cable"
GT_DEVICE=""
for arg in "$@"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    GT_DEVICE="$arg"
  else
    MIDI_DEV="$arg"
  fi
done

SERVER_CK="server.ck:local:${MIDI_DEV}:sim:pad"
mkdir -p "$LOG_DIR"

if ! command -v chuck >/dev/null 2>&1; then
  echo "chuck not found in PATH" >&2
  exit 1
fi

if pgrep -f "chuck.*$PROJECT_DIR/(server|client|autonomousFeeder|gametrakConductor)\\.ck" >/dev/null 2>&1; then
  echo "Stopping existing DS10 processes..."
  "$SCRIPT_DIR/local-stop"
  sleep 1
fi

if command -v lsof >/dev/null 2>&1; then
  for slot in 0 1 2 3 4 5 6 7; do
    for port in $((9000 + slot)) $((9100 + slot)) $((9200 + slot)); do
      lsof -ti ":$port" 2>/dev/null | xargs kill -9 2>/dev/null || true
    done
  done
  sleep 0.5
fi

cd "$PROJECT_DIR"

BG_PIDS=()
cleanup() {
  echo ""
  echo "Stopping performance stack..."
  for pid in "${BG_PIDS[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "DS10 local perform — $PROJECT_DIR"
echo "  logs: $LOG_DIR"
echo ""

CLIENT_ARGS_BASE="local:pkmn:headless:sim"
for slot in 0 1 2 3 4 5 6 7; do
  chuck "client.ck:${slot}:${CLIENT_ARGS_BASE}" >"$LOG_DIR/client-${slot}.log" 2>&1 &
  BG_PIDS+=("$!")
  echo "  client slot $slot  pid $!"
done

FEEDER_ARGS="autonomousFeeder.ck:local"
chuck "$FEEDER_ARGS" >"$LOG_DIR/feeder.log" 2>&1 &
BG_PIDS+=("$!")
echo "  feeder           pid $!"

GT_CK="gametrakConductor.ck:local"
if [[ -n "$GT_DEVICE" ]]; then
  GT_CK="${GT_CK}:${GT_DEVICE}"
fi
chuck "$GT_CK" >"$LOG_DIR/gametrak.log" 2>&1 &
BG_PIDS+=("$!")
echo "  gametrak         pid $!"

echo ""
echo "Waiting for clients..."
sleep 3

FAILED=0
GT_PID="${BG_PIDS[$(( ${#BG_PIDS[@]} - 1 ))]}"
if ! kill -0 "$GT_PID" 2>/dev/null; then
  echo "ERROR: gametrak exited — see $LOG_DIR/gametrak.log" >&2
  tail -20 "$LOG_DIR/gametrak.log" >&2
  FAILED=1
elif ! grep -q "GameTrak:" "$LOG_DIR/gametrak.log" 2>/dev/null; then
  echo "WARN: gametrak may still be starting — see $LOG_DIR/gametrak.log" >&2
fi
for slot in 0 1 2 3 4 5 6 7; do
  idx=$((slot))
  if ! kill -0 "${BG_PIDS[$idx]}" 2>/dev/null; then
    echo "ERROR: client $slot exited — see $LOG_DIR/client-${slot}.log" >&2
    tail -15 "$LOG_DIR/client-${slot}.log" >&2
    FAILED=1
  elif grep -qE 'EXCEPTION|RuntimeCast|cannot cast' "$LOG_DIR/client-${slot}.log" 2>/dev/null; then
    echo "ERROR: client $slot runtime error — see $LOG_DIR/client-${slot}.log" >&2
    tail -15 "$LOG_DIR/client-${slot}.log" >&2
    FAILED=1
  fi
done
if [[ "$FAILED" -eq 1 ]]; then
  exit 1
fi

echo ""
echo "Server foreground — TimGM monitor: $MIDI_DEV"
echo "  Pedals: 1=chaos | MIDI=mute | 2=Owl | 3=Parrots | 4=Peacock/Swan | 5–8=mvts | 9=solo"
echo "  Ctrl+C stops everything"
echo ""

exec chuck "$SERVER_CK"
