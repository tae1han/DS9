#!/bin/bash
cd "$(dirname "$0")/.."
networksetup -setairportpower en0 off 2>/dev/null || true
trap 'networksetup -setairportpower en0 on 2>/dev/null || true' EXIT
MIDI_DEV="USB Midi Cable"
for arg in "$@"; do [[ "$arg" != [0-9]* ]] && MIDI_DEV="$arg"; done
chuck autonomousFeeder.ck >/dev/null 2>&1 &
exec chuck "server.ck:${MIDI_DEV}:sim:pad"
