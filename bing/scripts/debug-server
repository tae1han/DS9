#!/bin/bash
# Concert debug: piano monitor server (foreground) + feeder + studio GUI.
#
# Server runs in the FOREGROUND — same as solo-monitor-test (proven working).
# Feeder and studioConductor run in the background.
#
# Usage:
#   ./scripts/debug-server
#   ./scripts/debug-server "USB Midi Cable"

set -euo pipefail

networksetup -setairportpower en0 off 2>/dev/null || true

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT_DIR/.local-logs"
mkdir -p "$LOG_DIR"

MIDI_DEV="USB Midi Cable"
for arg in "$@"; do
  [[ "$arg" != [0-9]* ]] && MIDI_DEV="$arg"
done

# Identical to solo-monitor-test, plus concert sim/pad.
SERVER_ARGS="${MIDI_DEV}:solo:sim:pad:midiLog:monitorTrace"

cleanup() {
  pkill -f "chuck.*$PROJECT_DIR/" 2>/dev/null || true
  networksetup -setairportpower en0 on 2>/dev/null || true
}
trap cleanup EXIT INT TERM

command -v chuck >/dev/null || { echo "chuck not found" >&2; exit 1; }
cd "$PROJECT_DIR"

echo "Stopping all Chuck in $PROJECT_DIR..."
pkill -f "chuck.*$PROJECT_DIR/" 2>/dev/null || true
sleep 1

for f in server.ck studioConductor.ck autonomousFeeder.ck; do
  [[ -f "$PROJECT_DIR/$f" ]] || { echo "missing $f" >&2; exit 1; }
done

echo ""
echo "debug-server (server FOREGROUND — same as solo-monitor-test)"
echo "  dir:  $PROJECT_DIR"
echo "  MIDI: $MIDI_DEV"
echo "  log:  $LOG_DIR/server.log (tee)"
echo ""
echo "Keys 28-35: CONTROL only, no piano. Other keys: TRACE MONITOR_PLAY"
echo "Ctrl+C stops everything"
echo ""

chuck "$PROJECT_DIR/autonomousFeeder.ck" >/dev/null 2>&1 &
FEEDER_PID=$!

chuck "$PROJECT_DIR/studioConductor.ck" >/dev/null 2>&1 &
STUDIO_PID=$!

sleep 1

# Server in foreground (matches solo-monitor-test). Tee log for later inspection.
exec chuck "$PROJECT_DIR/server.ck:${SERVER_ARGS}" 2>&1 | tee "$LOG_DIR/server.log"
