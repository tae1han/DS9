#!/bin/bash
# Eight-station local studio: server + 8 headless clients + ChuGL conductor GUI.
#
# Usage (from DS9/v10-studio):
#   ./scripts/local-studio
#   ./scripts/local-studio "USB Midi Cable"
#
# Opens studioConductor.ck (Movements + per-slot controls). No GameTrak required.
# Logs: .local-logs/{client-*,feeder,studio,server}.log
# Stop: Ctrl+C in server terminal, or ./scripts/local-stop

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT_DIR/.local-logs"

MIDI_DEV="USB Midi Cable"
for arg in "$@"; do
  if [[ "$arg" != "solo" ]]; then
    MIDI_DEV="$arg"
  fi
done

SERVER_CK="server.ck:local:${MIDI_DEV}:sim"
mkdir -p "$LOG_DIR"

if ! command -v chuck >/dev/null 2>&1; then
  echo "chuck not found in PATH" >&2
  exit 1
fi

if pgrep -f "chuck.*$PROJECT_DIR/(server|client|autonomousFeeder|studioConductor|gametrakConductor)\\.ck" >/dev/null 2>&1; then
  echo "Stopping existing studio processes..."
  "$SCRIPT_DIR/local-stop"
  sleep 1
fi

if command -v lsof >/dev/null 2>&1; then
  for slot in 0 1 2 3 4 5 6 7; do
    for port in $((9000 + slot)) $((9100 + slot)) $((9200 + slot)); do
      lsof -ti ":$port" 2>/dev/null | xargs kill -9 2>/dev/null || true
    done
  done
  sleep 0.5
fi

cd "$PROJECT_DIR"

BG_PIDS=()
cleanup() {
  echo ""
  echo "Stopping studio stack..."
  for pid in "${BG_PIDS[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "DS10 local studio — $PROJECT_DIR"
echo "  ChuGL conductor GUI (no GameTrak)"
echo "  logs: $LOG_DIR"
echo ""

CLIENT_ARGS_BASE="local:pkmn:headless:sim"
for slot in 0 1 2 3 4 5 6 7; do
  chuck "client.ck:${slot}:${CLIENT_ARGS_BASE}" >"$LOG_DIR/client-${slot}.log" 2>&1 &
  BG_PIDS+=("$!")
  echo "  client slot $slot  pid $!"
done

echo ""
echo "Starting server (before GUI so startup OSC cannot race movements)..."
chuck "$SERVER_CK" >"$LOG_DIR/server.log" 2>&1 &
SERVER_PID=$!
BG_PIDS+=("$SERVER_PID")
echo "  server           pid $SERVER_PID"

SERVER_READY=0
for _ in $(seq 1 40); do
  if grep -q "v10 server OSC" "$LOG_DIR/server.log" 2>/dev/null; then
    SERVER_READY=1
    break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "ERROR: server exited during startup — see $LOG_DIR/server.log" >&2
    tail -20 "$LOG_DIR/server.log" >&2
    exit 1
  fi
  sleep 0.25
done
if [[ "$SERVER_READY" -ne 1 ]]; then
  echo "ERROR: server did not become ready — see $LOG_DIR/server.log" >&2
  tail -20 "$LOG_DIR/server.log" >&2
  exit 1
fi

chuck "autonomousFeeder.ck:local" >"$LOG_DIR/feeder.log" 2>&1 &
BG_PIDS+=("$!")
echo "  feeder           pid $!"

chuck "studioConductor.ck:local" >"$LOG_DIR/studio.log" 2>&1 &
BG_PIDS+=("$!")
echo "  studio GUI       pid $!"

echo ""
echo "Waiting for clients and studio GUI..."
sleep 3

FAILED=0
for slot in 0 1 2 3 4 5 6 7; do
  if ! kill -0 "${BG_PIDS[$slot]}" 2>/dev/null; then
    echo "ERROR: client $slot exited — see $LOG_DIR/client-${slot}.log" >&2
    tail -15 "$LOG_DIR/client-${slot}.log" >&2
    FAILED=1
  elif grep -qE 'EXCEPTION|RuntimeCast|cannot cast' "$LOG_DIR/client-${slot}.log" 2>/dev/null; then
    echo "ERROR: client $slot runtime error — see $LOG_DIR/client-${slot}.log" >&2
    tail -15 "$LOG_DIR/client-${slot}.log" >&2
    FAILED=1
  fi
done

STUDIO_PID="${BG_PIDS[$(( ${#BG_PIDS[@]} - 1 ))]}"
if ! kill -0 "$STUDIO_PID" 2>/dev/null; then
  echo "ERROR: studio conductor exited — see $LOG_DIR/studio.log" >&2
  tail -20 "$LOG_DIR/studio.log" >&2
  FAILED=1
elif ! grep -q "Studio conductor ready" "$LOG_DIR/studio.log" 2>/dev/null; then
  echo "WARN: studio GUI may still be starting — see $LOG_DIR/studio.log" >&2
fi

if [[ "$FAILED" -eq 1 ]]; then
  exit 1
fi

echo ""
echo "Studio ready — TimGM monitor: $MIDI_DEV"
echo "  Server log: $LOG_DIR/server.log"
echo "  Use the ChuGL windows to activate slots, pick roles, adjust gains, run movements"
echo "  Feeder starts when you click Chaos2 + feeder (or uncheck Feeder paused)"
echo "  Ctrl+C stops everything"
echo ""

wait "$SERVER_PID"
