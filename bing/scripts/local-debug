#!/bin/bash
# Single-agent local debug: server (piano monitor) + one PKMN client.
# Manual OSC control only — no auto score timeline.
#
# Usage (from DS9/v10-dev):
#   ./scripts/local-debug
#   ./scripts/local-debug "USB Midi Cable" 7
#   ./scripts/local-debug "USB Midi Cable" 7 flash
#
# Control (second terminal):
#   chuck tests/localSend.ck:owlSeed:7

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT_DIR/.local-logs"

MIDI_DEV="USB Midi Cable"
SLOT=0
USE_FLASH=0
for arg in "$@"; do
  if [[ "$arg" == "flash" ]]; then
    USE_FLASH=1
  elif [[ "$arg" =~ ^[0-7]$ ]]; then
    SLOT="$arg"
  else
    MIDI_DEV="$arg"
  fi
done

mkdir -p "$LOG_DIR"

if ! command -v chuck >/dev/null 2>&1; then
  echo "chuck not found in PATH" >&2
  exit 1
fi

if pgrep -f "chuck.*$PROJECT_DIR/(server|client)\\.ck" >/dev/null 2>&1; then
  echo "Stopping existing DS10 processes..."
  pkill -f "chuck.*$PROJECT_DIR/server.ck" 2>/dev/null || true
  pkill -f "chuck.*$PROJECT_DIR/client.ck" 2>/dev/null || true
  sleep 1
fi
if command -v lsof >/dev/null 2>&1; then
  for port in $((9000 + SLOT)) $((9100 + SLOT)) $((9200 + SLOT)); do
    lsof -ti ":$port" 2>/dev/null | xargs kill -9 2>/dev/null || true
  done
  sleep 0.5
fi

cd "$PROJECT_DIR"

CLIENT_PID=""
cleanup() {
  echo ""
  echo "Stopping client..."
  kill "$CLIENT_PID" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "Agent debug — slot $SLOT (PKMN in data/, no score)"
echo "Log: $LOG_DIR/client-${SLOT}.log"
echo ""

CLIENT_ARGS="${SLOT}:local:pkmn"
if [[ "$USE_FLASH" -eq 1 ]]; then
  CLIENT_ARGS="${CLIENT_ARGS}:flash"
fi
chuck client.ck:"${CLIENT_ARGS}" >"$LOG_DIR/client-${SLOT}.log" 2>&1 &
CLIENT_PID=$!
echo "  client slot $SLOT  pid $CLIENT_PID"
sleep 2
if ! kill -0 "$CLIENT_PID" 2>/dev/null; then
  echo "ERROR: client exited — see $LOG_DIR/client-${SLOT}.log" >&2
  tail -20 "$LOG_DIR/client-${SLOT}.log" >&2
  exit 1
fi
if grep -qE '\.ck:[0-9]+:[0-9]+: error:' "$LOG_DIR/client-${SLOT}.log" 2>/dev/null; then
  echo "ERROR: client compile error — see $LOG_DIR/client-${SLOT}.log" >&2
  tail -20 "$LOG_DIR/client-${SLOT}.log" >&2
  kill "$CLIENT_PID" 2>/dev/null || true
  exit 1
fi
if ! grep -q "v10 client ${SLOT} ready" "$LOG_DIR/client-${SLOT}.log" 2>/dev/null; then
  echo "WARN: client may still be starting — check $LOG_DIR/client-${SLOT}.log" >&2
fi
if [[ "$USE_FLASH" -eq 1 ]]; then
  echo "  (ChuGL fullscreen flash: black idle, white on agent notes)"
fi

echo ""
echo "Server foreground — piano monitor on: $MIDI_DEV"
echo "  chuck tests/localSend.ck:owlSeed:${SLOT}"
echo ""

exec chuck "server.ck:local:${MIDI_DEV}"
