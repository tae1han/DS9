#!/bin/bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

MIDI_DEV="USB Midi Cable"
for arg in "$@"; do
  [[ "$arg" != [0-9]* ]] && MIDI_DEV="$arg"
done

command -v chuck >/dev/null || { echo "chuck not found" >&2; exit 1; }
cd "$PROJECT_DIR"

if pgrep -f "chuck.*$PROJECT_DIR/" >/dev/null 2>&1; then
  echo "Stopping stale Chuck processes in $PROJECT_DIR..."
  pkill -f "chuck.*$PROJECT_DIR/" 2>/dev/null || true
  sleep 1
fi

for f in graphics/performanceDisplay.ck server.ck autonomousFeeder.ck; do
  if [[ ! -f "$PROJECT_DIR/$f" ]]; then
    echo "missing $f in $PROJECT_DIR" >&2
    exit 1
  fi
done

chuck "$PROJECT_DIR/autonomousFeeder.ck:local" >/dev/null 2>&1 &
FEEDER_PID=$!
LOG_DIR="$PROJECT_DIR/.local-logs"
mkdir -p "$LOG_DIR"
chuck "$PROJECT_DIR/server.ck:local:${MIDI_DEV}:sim:pad:midiLog:monitorTrace" >"$LOG_DIR/server.log" 2>&1 &
SERVER_PID=$!
echo "  server log: $LOG_DIR/server.log"
cleanup() { kill "$SERVER_PID" "$FEEDER_PID" 2>/dev/null || true; }
trap cleanup EXIT INT TERM
sleep 1

echo "Server running — ChuGL monitor in server process (see $LOG_DIR/server.log)"
wait "$SERVER_PID"
