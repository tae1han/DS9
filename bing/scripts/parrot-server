#!/bin/bash
# Usage (from DS9/v10-dev on the server / piano laptop):
#   ./scripts/parrot-server
#   ./scripts/parrot-server "USB Midi Cable"
#   ./scripts/parrot-server "USB Midi Cable" 1    # GameTrak joystick index 1

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

MIDI_DEV="USB Midi Cable"
GT_DEVICE=""
for arg in "$@"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    GT_DEVICE="$arg"
  else
    MIDI_DEV="$arg"
  fi
done

if ! command -v chuck >/dev/null 2>&1; then
  echo "chuck not found in PATH" >&2
  exit 1
fi

cd "$PROJECT_DIR"

echo "DS10 cluster SERVER — $PROJECT_DIR"
echo "  multicast OSC (LAN)"
echo "  MIDI: $MIDI_DEV"
echo ""

chuck "autonomousFeeder.ck" >/dev/null 2>&1 &
echo "  feeder    pid $!  (idle until GameTrak pedal 1)"

GT_CK="gametrakConductor.ck"
if [[ -n "$GT_DEVICE" ]]; then
  GT_CK="${GT_CK}:${GT_DEVICE}"
fi
chuck "$GT_CK" >/dev/null 2>&1 &
echo "  gametrak  pid $!"

exec chuck -c6 "server.ck:${MIDI_DEV}:pad" --bufsize:1024
