#!/bin/bash
# Eight-station local sim: server + 8 headless PKMN clients (no ChuGL).
#
# Usage (from DS9/v10-dev):
#   ./scripts/local-run
#   ./scripts/local-run "USB Midi Cable"
#   ./scripts/local-run solo                       # server monitor only
#
# After start (manual setups):
#   chuck tests/localSend.ck:scene:m1
#
# Stop: ./scripts/local-stop  or Ctrl+C in server terminal

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT_DIR/.local-logs"

MIDI_DEV="USB Midi Cable"
SOLO=0
for arg in "$@"; do
  if [[ "$arg" == "solo" ]]; then
    SOLO=1
  else
    MIDI_DEV="$arg"
  fi
done

SERVER_CK="server.ck:local:${MIDI_DEV}:sim:pad"

mkdir -p "$LOG_DIR"

if ! command -v chuck >/dev/null 2>&1; then
  echo "chuck not found in PATH" >&2
  exit 1
fi

if pgrep -f "chuck.*$PROJECT_DIR/(server|client)\\.ck" >/dev/null 2>&1; then
  echo "Stopping existing DS10 processes..."
  pkill -f "chuck.*$PROJECT_DIR/server.ck" 2>/dev/null || true
  pkill -f "chuck.*$PROJECT_DIR/client.ck" 2>/dev/null || true
  sleep 1
fi

if command -v lsof >/dev/null 2>&1; then
  for slot in 0 1 2 3 4 5 6 7; do
    for port in $((9000 + slot)) $((9100 + slot)) $((9200 + slot)); do
      lsof -ti ":$port" 2>/dev/null | xargs kill -9 2>/dev/null || true
    done
  done
  sleep 0.5
fi

cd "$PROJECT_DIR"

if [[ "$SOLO" -eq 1 ]]; then
  echo "Solo server (TimGM monitor only). MIDI: $MIDI_DEV"
  exec chuck "$SERVER_CK"
fi

CLIENT_PIDS=()
cleanup() {
  echo ""
  echo "Stopping clients..."
  for pid in "${CLIENT_PIDS[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "Eight-station local sim — $PROJECT_DIR"
echo "  clients: headless + pkmn + sim mix (master ~0.38; piano monitor lowered)"
echo "  logs:    $LOG_DIR/client-*.log"
echo ""

CLIENT_ARGS_BASE="local:pkmn:headless:sim"
for slot in 0 1 2 3 4 5 6 7; do
  chuck "client.ck:${slot}:${CLIENT_ARGS_BASE}" >"$LOG_DIR/client-${slot}.log" 2>&1 &
  CLIENT_PIDS+=("$!")
  echo "  client slot $slot  pid $!"
done

echo ""
echo "Waiting for clients..."
sleep 3
FAILED=0
for slot in 0 1 2 3 4 5 6 7; do
  if ! kill -0 "${CLIENT_PIDS[$slot]}" 2>/dev/null; then
    echo "ERROR: client $slot exited — see $LOG_DIR/client-${slot}.log" >&2
    tail -15 "$LOG_DIR/client-${slot}.log" >&2
    FAILED=1
    continue
  fi
  if grep -qE '\.ck:[0-9]+:[0-9]+: error:|EXCEPTION|RuntimeCast|cannot cast' "$LOG_DIR/client-${slot}.log" 2>/dev/null; then
    echo "ERROR: client $slot error — see $LOG_DIR/client-${slot}.log" >&2
    tail -15 "$LOG_DIR/client-${slot}.log" >&2
    FAILED=1
  elif ! grep -q "v10 client ${slot} ready" "$LOG_DIR/client-${slot}.log" 2>/dev/null; then
    echo "WARN: client $slot may still be starting — check $LOG_DIR/client-${slot}.log" >&2
  fi
done
if [[ "$FAILED" -eq 1 ]]; then
  exit 1
fi

echo ""
echo "Server foreground — TimGM monitor on: $MIDI_DEV"
echo "  Movements via MIDI (see score/composition.txt) or chuck tests/localSend.ck:scene:1a"
echo "  Ctrl+C stops server + all clients"
echo ""
echo "Full stack with display:"
echo "  ./scripts/local-studio"
echo ""

exec chuck "$SERVER_CK"
