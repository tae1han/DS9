#!/bin/bash
# One station per laptop (station 1-8 = slot 0-7)
# Usage: local-client <station-number 1-8> [local] [headless]

if test $# -lt 1; then
    echo "usage: $0 <station-number 1-8> [local] [headless]"
    exit 1
fi

SLOT=$(($1 - 1))

if [ $SLOT -lt 0 ] || [ $SLOT -gt 7 ]; then
    echo "station must be 1-8"
    exit 1
fi

EXTRA_ARGS=()
shift
for arg in "$@"; do
    EXTRA_ARGS+=("$arg")
done

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

networksetup -setairportpower en0 off 2>/dev/null || true
osascript -e "set Volume 4" 2>/dev/null || true

cleanup() {
    echo -e "\nShutting down..."
    networksetup -setairportpower en0 on 2>/dev/null || true
    exit 0
}
trap cleanup SIGINT

kb_device=$(chuck --probe 2>&1 | awk '/keyboard/{kb=1} kb && /Apple Internal Keyboard/{gsub(/[][]/, "", $2); print $2; exit}')

pushd "$PROJECT_DIR" >/dev/null || exit 1
if [ -n "$kb_device" ] && [[ " ${EXTRA_ARGS[*]} " != *" headless "* ]]; then
    chuck -c6 client.ck:$SLOT "${EXTRA_ARGS[@]}" :$kb_device --bufsize:1024
else
    chuck -c6 client.ck:$SLOT "${EXTRA_ARGS[@]}" --bufsize:1024
fi
popd

networksetup -setairportpower en0 on 2>/dev/null || true
